---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { FOOTER_LINKS, SITE } from '@/lib/site';
import { url } from '@/lib/url';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell">
    <div class="footer__grid">
      <div class="footer__brand">
        <Brand link={true} size={38} />
        <p class="footer__tagline">{SITE.tagline}</p>
        <p class="footer__meta">
          Native Android TV home launcher · v{SITE.version}
        </p>
        <a class="footer__repo" href={SITE.repo} target="_blank" rel="noopener noreferrer">
          <Icon name="github" size={18} />
          vryptt-ctrl/BlueLauncher
          <Icon name="external" size={14} />
        </a>
      </div>

      {
        FOOTER_LINKS.map((group) => (
          <nav class="footer__col" aria-label={group.title}>
            <h2 class="footer__title">{group.title}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href.startsWith('http') ? link.href : url(link.href)}
                    {...(link.href.startsWith('http')
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer__base">
      <p>© {year} BlueLauncher contributors. Code under GPL-3.0, brand assets under CC BY 4.0.</p>
      <p class="footer__offline">
        <Icon name="offline" size={15} />
        This site loads no third-party scripts, fonts or analytics.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    margin-top: var(--gap-2xl);
    border-top: 1px solid var(--border);
    background: linear-gradient(180deg, rgb(17 26 42 / 40%), var(--bg-deep));
    padding-block: var(--gap-xl) var(--gap-lg);
  }

  .footer__grid {
    display: grid;
    gap: var(--gap-lg);
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .footer__grid {
      grid-template-columns: 1.6fr repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .footer__grid {
      grid-template-columns: 1.7fr repeat(4, 1fr);
      gap: var(--gap-md);
    }
  }

  .footer__brand {
    max-width: 34ch;
  }

  .footer__tagline {
    margin-top: var(--gap);
    color: var(--text-muted);
    font-size: var(--step-0);
  }

  .footer__meta {
    margin-top: 0.5rem;
    color: var(--text-faint);
    font-size: var(--step--1);
  }

  .footer__repo {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: var(--gap);
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-pill);
    color: var(--text-muted);
    font-size: var(--step--1);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .footer__repo:hover {
    border-color: var(--border-accent);
    color: var(--text);
  }

  .footer__title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: var(--gap-sm);
  }

  .footer__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer__col a {
    color: var(--text-dim);
    font-size: var(--step-0);
    text-decoration: none;
  }

  .footer__col a:hover {
    color: var(--cyan);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm);
    margin-top: var(--gap-xl);
    padding-top: var(--gap);
    border-top: 1px solid var(--border);
    color: var(--text-faint);
    font-size: var(--step--1);
  }

  .footer__offline {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
</style>
