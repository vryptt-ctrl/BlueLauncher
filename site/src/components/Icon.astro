---
/**
 * Inline `<use>` reference into the shared first-party sprite at /icons.svg
 * (generated from src/data/icons.ts by scripts/build-icons.mjs). Each instance
 * is one short line; path data ships once and is cached across pages.
 */
import type { IconName } from '@/data/icons';

interface Props {
  name: IconName;
  size?: number;
  /** Decorative icons are hidden from assistive tech; labelled ones get a title. */
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  role={label ? 'img' : undefined}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  focusable="false"
>
  <use href={`/icons.svg#i-${name}`}></use>
</svg>

<style>
  .icon {
    flex: none;
    vertical-align: middle;
  }
</style>
