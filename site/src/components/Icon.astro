---
import { ICON_PATHS, GLYPH_FILLED, type IconName } from '@/data/icons';

interface Props {
  name: IconName;
  size?: number;
  /** Decorative icons are hidden from assistive tech; labelled ones get a title. */
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
const filled = GLYPH_FILLED.includes(name);
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  focusable="false"
  set:html={ICON_PATHS[name]}
/>

<style>
  .icon {
    flex: none;
    vertical-align: middle;
  }
</style>
