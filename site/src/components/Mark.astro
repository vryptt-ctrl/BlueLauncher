---
/**
 * The brand mark: a 2×2 tile grid with the top-right tile lit and ringed.
 * Geometry is copied from brand/svg/icon.svg (viewBox 0 0 100 100) so the site
 * mark and the launcher icon stay pixel-identical.
 */
interface Props {
  size?: number;
  /** Ring and lit-tile colors track the surface the mark sits on. */
  tone?: 'dark' | 'color';
  class?: string;
  title?: string;
}

const { size = 40, tone = 'color', class: className, title } = Astro.props;
const dim = tone === 'color' ? '#3A5C94' : '#2A4470';
const radius = 7;
---

<svg
  class:list={['mark', className]}
  width={size}
  height={size}
  viewBox="15 11 74 74"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  <rect x="21" y="21" width="26" height="26" rx={radius} fill={dim}></rect>
  <rect x="21" y="53" width="26" height="26" rx={radius} fill={dim}></rect>
  <rect x="53" y="53" width="26" height="26" rx={radius} fill={dim}></rect>
  <rect x="53" y="21" width="26" height="26" rx={radius} fill="url(#mark-lit)"></rect>
  <rect
    x="50"
    y="18"
    width="32"
    height="32"
    rx="9.5"
    fill="none"
    stroke="#7CE1FF"
    stroke-width="2.5"></rect>
  <defs>
    <linearGradient id="mark-lit" x1="53" y1="21" x2="79" y2="47" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#5AA9FF"></stop>
      <stop offset="1" stop-color="#2F7DFF"></stop>
    </linearGradient>
  </defs>
</svg>

<style>
  .mark {
    flex: none;
    overflow: visible;
  }
</style>
