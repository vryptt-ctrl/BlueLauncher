---
import { Picture } from 'astro:assets';
import { SHOTS } from '@/data/shots';

/**
 * Tabbed screenshot viewer. Small screens get a native scroll-snap strip and
 * the tabs become a plain list, so the markup stays useful without JS.
 */
---

<section class="gallery" data-gallery aria-roledescription="carousel" aria-label="App screenshots">
  <div class="gallery__stage">
    {
      SHOTS.map((shot, index) => (
        <figure
          class="gallery__panel"
          data-panel={shot.id}
          role="tabpanel"
          id={`panel-${shot.id}`}
          aria-labelledby={`tab-${shot.id}`}
          hidden={index !== 0}
        >
          <div class="gallery__frame">
            <Picture
              src={shot.image}
              alt={shot.alt}
              widths={[640, 960, 1280, 1920]}
              sizes="(min-width: 1100px) 960px, 92vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              loading={index === 0 ? 'eager' : 'lazy'}
              class="gallery__image"
            />
          </div>
          <figcaption class="gallery__caption">
            <span class="gallery__index">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="gallery__title">{shot.title}</h3>
              <p class="gallery__text">{shot.caption}</p>
            </div>
          </figcaption>
        </figure>
      ))
    }
  </div>

  <div class="gallery__tabs" role="tablist" aria-label="Choose a screenshot">
    {
      SHOTS.map((shot, index) => (
        <button
          class="gallery__tab"
          type="button"
          role="tab"
          id={`tab-${shot.id}`}
          data-tab={shot.id}
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`panel-${shot.id}`}
          tabindex={index === 0 ? 0 : -1}
        >
          <span class="gallery__thumb">
            <Picture
              src={shot.image}
              alt=""
              widths={[160, 320]}
              sizes="120px"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              loading="lazy"
            />
          </span>
          <span class="gallery__tab-label">{shot.title}</span>
        </button>
      ))
    }
  </div>
</section>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');

  if (gallery) {
    const tabs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...gallery.querySelectorAll<HTMLElement>('[data-panel]')];

    const select = (id: string, focus = false) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.tab === id;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== id;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab.dataset.tab!));

      // Roving tabindex: arrows move between tabs, Home/End jump to the edges.
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        let next: number | null = null;
        if (event.key === 'ArrowRight') next = index === last ? 0 : index + 1;
        if (event.key === 'ArrowLeft') next = index === 0 ? last : index - 1;
        if (event.key === 'Home') next = 0;
        if (event.key === 'End') next = last;
        if (next === null) return;
        event.preventDefault();
        select(tabs[next].dataset.tab!, true);
      });
    });
  }
</script>

<style>
  .gallery {
    display: grid;
    gap: var(--gap-md);
  }

  .gallery__frame {
    padding: 10px;
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, #1c273f, #0d1526);
    border: 1px solid var(--border-strong);
    box-shadow:
      0 48px 100px -55px rgb(0 0 0 / 95%),
      0 0 0 1px rgb(124 225 255 / 8%);
  }

  .gallery__image {
    width: 100%;
    border-radius: calc(var(--r-lg) - 8px);
    background: var(--bg-deep);
  }

  .gallery__panel {
    margin: 0;
    display: grid;
    gap: var(--gap);
  }

  .gallery__panel[hidden] {
    display: none;
  }

  .gallery__caption {
    display: flex;
    align-items: flex-start;
    gap: var(--gap);
    padding-inline: 0.25rem;
  }

  .gallery__index {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--cyan);
    padding-top: 0.35em;
  }

  .gallery__title {
    font-size: var(--step-2);
    letter-spacing: -0.015em;
  }

  .gallery__text {
    margin-top: 0.3rem;
    color: var(--text-dim);
    font-size: var(--step-0);
    max-width: 70ch;
  }

  .gallery__tabs {
    display: flex;
    gap: var(--gap-sm);
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  .gallery__tabs::-webkit-scrollbar {
    display: none;
  }

  .gallery__tab {
    display: grid;
    gap: 0.5rem;
    flex: 0 0 auto;
    width: 132px;
    padding: 0.45rem;
    border-radius: var(--r-md);
    border: 1px solid var(--border);
    background: rgb(17 26 42 / 60%);
    color: var(--text-dim);
    text-align: start;
    scroll-snap-align: start;
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .gallery__tab:hover {
    border-color: var(--border-accent);
    color: var(--text);
  }

  .gallery__tab[aria-selected='true'] {
    border-color: var(--cyan);
    background: rgb(47 125 255 / 14%);
    color: var(--text);
    box-shadow: 0 0 0 1px rgb(124 225 255 / 35%);
  }

  .gallery__thumb {
    display: block;
    overflow: hidden;
    border-radius: var(--r-sm);
    background: var(--bg-deep);
    aspect-ratio: 16 / 9;
  }

  .gallery__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__tab-label {
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: -0.005em;
  }
</style>
