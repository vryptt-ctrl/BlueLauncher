---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/lib/site';
import { url } from '@/lib/url';

const codeTerms = [
  'You can run, study, share and modify the launcher.',
  'If you distribute a modified version, you must publish its source under the same licence.',
  'There is no warranty. Use it at your own risk.',
  'The GPL covers the Kotlin and Rust source in this repository.',
];

const assetTerms = [
  'You may use, adapt and redistribute the logo, icons and banner, including commercially.',
  'You must give appropriate credit and link to the licence.',
  'You may not imply the BlueLauncher authors endorse your project.',
  'The CC BY licence is independent of the code licence.',
];
---

<Base
  title="Licenses"
  description="BlueLauncher is GPL-3.0 for code and CC BY 4.0 for brand assets. Here is what each means in practice."
>
  <div class="page-intro">
    <p class="kicker">Licenses</p>
    <h1 class="display page-intro__title">Licenses</h1>
    <p class="lede">
      The code is GPL-3.0. The logo, icons and banner are CC BY 4.0. This page summarizes what each
      licence allows.
    </p>
  </div>

  <div class="cards">
    <section class="lic" aria-labelledby="code-title">
      <span class="lic__badge">Code</span>
      <h2 class="lic__title" id="code-title">GPL-3.0</h2>
      <p class="lic__sub">GNU General Public License, version 3</p>
      <ul class="lic__list">
        {
          codeTerms.map((term) => (
            <li>
              <Icon name="check" size={16} />
              {term}
            </li>
          ))
        }
      </ul>
      <Button href={SITE.licenseCode} external variant="secondary" icon="external">
        Read the full text
      </Button>
    </section>

    <section class="lic" aria-labelledby="assets-title">
      <span class="lic__badge lic__badge--alt">Brand</span>
      <h2 class="lic__title" id="assets-title">CC BY 4.0</h2>
      <p class="lic__sub">Creative Commons Attribution 4.0 International</p>
      <ul class="lic__list">
        {
          assetTerms.map((term) => (
            <li>
              <Icon name="check" size={16} />
              {term}
            </li>
          ))
        }
      </ul>
      <Button href={SITE.licenseAssets} external variant="secondary" icon="external">
        Read the asset licence
      </Button>
    </section>
  </div>

  <section class="section" aria-labelledby="why-title">
    <SectionHead kicker="Why two licences" title="Code and assets are licensed separately" id="why-title" />
    <div class="prose-custom">
      <p class="muted">
        A launcher is a program, and programs benefit from copyleft: if someone ships an improved
        fork of BlueLauncher, those improvements should be available to the next person. That is the
        GPL's job.
      </p>
      <p class="muted">
        A logo is not a program. Enforcing copyleft on an icon would stop a blog post, a video or a
        distro package from using the mark for no useful reason. CC BY keeps attribution and drops
        everything else.
      </p>
      <p class="muted">
        Neither licence grants trademark rights. Do not present a fork as the official BlueLauncher
        release, and do not use the mark to imply endorsement.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="notice">
      <h2 class="h3">Third-party components</h2>
      <p class="muted">
        The app bundles Inter and Material Symbols glyphs from Google Fonts, each under the SIL Open
        Font License; the licence files ship inside the APK assets. This site self-hosts the same
        Inter files — <a href={url('/licenses/INTER-OFL.txt')}>the OFL text</a> is published alongside
        them. Rust crates retain their own licences, listed through Cargo.
      </p>
      <p class="dim">Version {SITE.version} · code GPL-3.0 · assets CC BY 4.0</p>
    </div>
  </section>
</Base>

<style>
  .page-intro {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) var(--gap-xl);
    max-width: 66ch;
  }

  .page-intro__title {
    margin-top: var(--gap);
    font-size: clamp(2rem, 1.3rem + 3vw, 3.25rem);
  }

  .page-intro :global(.lede) {
    margin-top: var(--gap-md);
  }

  .cards {
    display: grid;
    gap: var(--gap);
  }

  @media (min-width: 800px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .lic {
    display: grid;
    align-content: start;
    gap: var(--gap-sm);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-xl);
    background:
      radial-gradient(120% 120% at 0% 0%, rgb(47 125 255 / 10%), transparent 60%),
      linear-gradient(180deg, rgb(28 39 63 / 50%), rgb(11 17 29 / 92%));
  }

  .lic__badge {
    justify-self: start;
    padding: 0.15rem 0.55rem;
    border-radius: var(--r-pill);
    border: 1px solid rgb(124 225 255 / 30%);
    background: rgb(124 225 255 / 10%);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .lic__badge--alt {
    border-color: rgb(47 125 255 / 45%);
    background: rgb(47 125 255 / 14%);
    color: var(--accent-bright);
  }

  .lic__title {
    font-family: var(--font-mono);
    font-size: var(--step-3);
    letter-spacing: -0.04em;
  }

  .lic__sub {
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .lic__list {
    list-style: none;
    padding: 0;
    margin: var(--gap-sm) 0 0;
    display: grid;
    gap: var(--gap-sm);
  }

  .lic__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: var(--step-0);
    color: var(--text-muted);
  }

  .lic__list :global(svg) {
    margin-top: 0.22em;
    color: var(--cyan);
  }

  .lic :global(.btn) {
    margin-top: var(--gap);
    justify-self: start;
  }

  .prose-custom {
    max-width: 68ch;
    display: grid;
    gap: var(--gap);
  }

  .prose-custom p {
    font-size: var(--step-0);
  }

  .notice {
    max-width: 68ch;
    padding: var(--gap-md);
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-md);
  }

  .notice p {
    margin-top: var(--gap-sm);
    font-size: var(--step-0);
  }
</style>
