---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SectionHead from '@/components/SectionHead.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import SpecTable from '@/components/SpecTable.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import { FEATURE_GROUPS } from '@/data/features';
import { SCORE_TABLE, DEPENDENCIES } from '@/data/content';
import type { IconName } from '@/data/icons';
import { SITE } from '@/lib/site';
import { url } from '@/lib/url';

const title = 'Android TV launcher features';
const description =
  'What BlueLauncher does on an Android TV box: Rust-ranked app search, pin-ordered favorites, bounded recents, category filters and three dark themes. Offline, no ads.';
const keywords = [
  'Android TV launcher features',
  'Android TV app search',
  'TV launcher favorites',
  'dark Android TV launcher',
  'Leanback launcher',
];
const crumbs = [{ name: 'Features', path: '/features/' }];
---

<Base title={title} description={description} keywords={keywords} breadcrumb={crumbs}>
  <div class="page-intro">
    <p class="kicker">Features</p>
    <h1 class="display page-intro__title">Everything an Android TV home screen needs</h1>
    <p class="lede page-intro__lede">
      Rust-ranked search, ordered favorites, bounded recents, category filters and three dark themes
      — all local, all offline.
    </p>
    <Breadcrumbs items={crumbs} />
  </div>

  {
    FEATURE_GROUPS.map((group, index) => (
      <section class="section" aria-labelledby={`group-${group.id}`} id={group.id}>
        <div class="group-head">
          <span class="group-head__index">{String(index + 1).padStart(2, '0')}</span>
          <SectionHead
            kicker={group.kicker}
            title={group.title}
            lede={group.lede}
            id={`group-${group.id}`}
          />
        </div>
        <div class="grid">
          {group.features.map((feature) => (
            <FeatureCard
              icon={feature.icon as IconName}
              title={feature.title}
              body={feature.body}
            />
          ))}
        </div>
      </section>
    ))
  }

  <!-- ── Search scoring ──────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="scoring">
    <SectionHead
      kicker="How ranking works"
      title="Search scoring"
      lede="The Rust core assigns a text score to each candidate, then adds a pin and recency boost. Favorites and recents never outrank an exact label match."
      id="scoring"
    />
    <div class="split">
      <SpecTable
        head={['Match type', 'Score']}
        rows={SCORE_TABLE.map((row) => [
          row.match,
          { text: row.score, mono: row.score.startsWith('+') || /^\d+$/.test(row.score) },
        ])}
      />
      <div class="notes">
        <h3 class="h3">Fallback stays identical</h3>
        <p class="muted">
          When the native library is missing — an unsupported ABI, for instance — the Kotlin scorer
          applies the same rules. Ranking results do not change, only speed does.
        </p>
        <h3 class="h3">Bounded personalization</h3>
        <p class="muted">
          Recents are capped at twelve entries, so the recency bonus stays meaningful and the
          preference file stays small. Favorites keep a manual order you control.
        </p>
        <Button href={url('/architecture/')} variant="secondary" icon="code" trailing="arrow">
          Read the architecture
        </Button>
      </div>
    </div>
  </section>

  <!-- ── Constraints ─────────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="constraints">
    <SectionHead
      kicker="Deliberate constraints"
      title="What is left out"
      lede="Each of these is a decision, not an oversight."
      id="constraints"
    />
    <div class="grid">
      {
        DEPENDENCIES.map((item) => (
          <article class="card">
            <h3 class="card__title">{item.title}</h3>
            <p class="card__body">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section cta">
    <div class="cta__inner">
      <Icon name="download" size={28} />
      <h2 class="h3">Get the APK</h2>
      <p class="muted">Download a release build, or build it from source.</p>
      <div class="cluster">
        <Button href={SITE.releases} external icon="download">Download APK</Button>
        <Button href={url('/install/')} variant="secondary" icon="terminal"
          >Installation guide</Button
        >
      </div>
    </div>
  </section>
</Base>

<style>
  .page-intro {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) var(--gap-xl);
  }

  .page-intro__title {
    margin-top: var(--gap);
    max-width: 22ch;
    font-size: clamp(2rem, 1.3rem + 3vw, 3.25rem);
  }

  .page-intro__lede {
    margin-top: var(--gap-md);
    max-width: 62ch;
    font-size: var(--step-2);
  }

  .group-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--gap-md);
    align-items: start;
  }

  .group-head__index {
    padding-top: 0.15em;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-faint);
    letter-spacing: 0.1em;
  }

  .group-head :global(.head) {
    margin-bottom: var(--gap-lg);
  }

  .grid {
    display: grid;
    gap: var(--gap);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .split {
    display: grid;
    gap: var(--gap-lg);
  }

  @media (min-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .notes {
    display: grid;
    gap: var(--gap-sm);
    justify-items: start;
  }

  .notes h3 + p {
    margin-top: 0;
  }

  .notes p {
    font-size: var(--step-0);
    max-width: 48ch;
  }

  .notes :global(.btn) {
    margin-top: var(--gap-sm);
  }

  .cta__inner {
    display: grid;
    gap: var(--gap-sm);
    justify-items: center;
    text-align: center;
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-xl);
    background:
      radial-gradient(90% 120% at 50% 0%, rgb(47 125 255 / 16%), transparent 65%),
      linear-gradient(180deg, rgb(28 39 63 / 55%), rgb(11 17 29 / 90%));
  }

  .cta__inner :global(svg) {
    color: var(--cyan);
  }

  .cta__inner :global(.cluster) {
    justify-content: center;
    margin-top: var(--gap-md);
  }
</style>
