---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import { RELEASES } from '@/data/changelog';
import { SITE } from '@/lib/site';

const kindLabel: Record<string, string> = {
  Added: 'Added',
  Changed: 'Changed',
  Fixed: 'Fixed',
  Removed: 'Removed',
};
---

<Base
  title="Changelog"
  description="Release notes for BlueLauncher, following Keep a Changelog and Semantic Versioning."
>
  <div class="page-intro">
    <p class="kicker">Changelog</p>
    <h1 class="display page-intro__title">Changelog</h1>
    <p class="lede">
      The format follows Keep a Changelog and the project uses Semantic Versioning. The canonical
      file lives in the repository.
    </p>
    <div class="cluster page-intro__actions">
      <Button href={SITE.changelog} external variant="secondary" icon="external">
        Open CHANGELOG.md
      </Button>
      <Button href={SITE.allReleases} external icon="github">All GitHub releases</Button>
    </div>
  </div>

  <div class="timeline">
    {
      RELEASES.map((release) => (
        <section
          class="release"
          aria-labelledby={`v-${release.version}`}
          id={`v-${release.version}`}
        >
          <header class="release__head">
            <div class="release__version">
              <h2 id={`v-${release.version}`}>{release.version}</h2>
              {release.latest && <span class="tag">Latest</span>}
            </div>
            <time class="release__date" datetime={release.date}>
              {release.date}
            </time>
            <p class="release__summary">{release.summary}</p>
          </header>

          <div class="release__groups">
            {release.groups.map((group) => (
              <div class="group">
                <h3 class="group__kind">{kindLabel[group.kind] ?? group.kind}</h3>
                <ul class="group__list">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <section class="section">
    <div class="notice">
      <h2 class="h3">
        <Icon name="arrow" size={18} /> Unreleased
      </h2>
      <p class="muted">
        No changes are queued for the next release. If you want to propose one, open an issue on
        the <a href={SITE.issues}>issue tracker</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .page-intro {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) var(--gap-xl);
    max-width: 64ch;
  }

  .page-intro__title {
    margin-top: var(--gap);
    font-size: clamp(2rem, 1.3rem + 3vw, 3.25rem);
  }

  .page-intro :global(.lede) {
    margin-top: var(--gap-md);
  }

  .page-intro__actions {
    margin-top: var(--gap-lg);
  }

  .timeline {
    display: grid;
    gap: var(--gap-xl);
  }

  .release {
    display: grid;
    gap: var(--gap-md);
    padding-top: var(--gap-lg);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 900px) {
    .release {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: var(--gap-xl);
    }
  }

  .release__head {
    position: sticky;
    top: calc(var(--nav-h) + var(--gap));
    align-self: start;
  }

  @media (max-width: 899px) {
    .release__head {
      position: static;
    }
  }

  .release__version {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
  }

  .release__version h2 {
    font-family: var(--font-mono);
    font-size: var(--step-4);
    letter-spacing: -0.04em;
    color: var(--text);
  }

  .tag {
    padding: 0.15rem 0.5rem;
    border-radius: var(--r-pill);
    border: 1px solid rgb(124 225 255 / 35%);
    background: rgb(124 225 255 / 10%);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .release__date {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .release__summary {
    margin-top: var(--gap);
    max-width: 40ch;
    color: var(--text-muted);
    font-size: var(--step-0);
  }

  .release__groups {
    display: grid;
    gap: var(--gap-md);
  }

  .group__kind {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-bright);
    margin-bottom: var(--gap-sm);
  }

  .group__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  .group__list li {
    position: relative;
    padding-left: 1.35rem;
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--text-dim);
  }

  .group__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--surface-raised);
    box-shadow: 0 0 0 1px var(--border-strong);
  }

  .notice {
    max-width: 66ch;
    padding: var(--gap-md);
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-md);
  }

  .notice h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .notice h2 :global(svg) {
    color: var(--cyan);
    transform: rotate(90deg);
  }

  .notice p {
    margin-top: var(--gap-sm);
    font-size: var(--step-0);
  }
</style>
