---
import Base from '@/layouts/Base.astro';
import Mark from '@/components/Mark.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/lib/site';
import { url } from '@/lib/url';
---

<Base
  title="Page not found"
  description="That page does not exist on this site."
  canonicalPath="/"
  noindex
>
  <div class="nf">
    <Mark size={88} tone="dark" class="nf__mark" />
    <p class="kicker">Error 404</p>
    <h1 class="display nf__title">Page not found</h1>
    <p class="lede nf__text">
      The address is wrong or the page was moved. Try one of these instead.
    </p>
    <div class="cluster nf__actions">
      <Button href={url('/')} icon="arrow">Back to home</Button>
      <Button href={url('/install/')} variant="secondary" icon="terminal">Installation guide</Button
      >
      <Button href={SITE.repo} variant="secondary" icon="github" external>GitHub repository</Button>
    </div>
  </div>
</Base>

<style>
  .nf {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-block: clamp(3rem, 2rem + 8vw, 7rem);
    max-width: 58ch;
    margin-inline: auto;
  }

  .nf__mark {
    margin-bottom: var(--gap-md);
    opacity: 0.7;
  }

  .nf__title {
    margin-top: var(--gap-sm);
    font-size: clamp(2rem, 1.3rem + 3vw, 3rem);
  }

  .nf__text {
    margin-top: var(--gap-md);
    font-size: var(--step-2);
  }

  .nf__actions {
    justify-content: center;
    margin-top: var(--gap-lg);
  }
</style>
