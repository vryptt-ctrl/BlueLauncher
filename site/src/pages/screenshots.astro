---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Gallery from '@/components/Gallery.astro';
import SectionHead from '@/components/SectionHead.astro';
import { SHOTS } from '@/data/shots';
import { SITE } from '@/lib/site';
import { url } from '@/lib/url';

const crumbs = [{ name: 'Screenshots', path: '/screenshots/' }];
const keywords = [
  'Android TV launcher screenshots',
  'Android TV home screen UI',
  'TV launcher design',
];

/** ImageGallery schema so the shots can surface in image search. */
const gallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'BlueLauncher Android TV launcher screenshots',
  description: 'Home, search, favorites and settings at 1920×1080.',
  image: SHOTS.map(
    (shot) => `${(import.meta.env.SITE || 'https://bluelauncher.bond').replace(/\/+$/, '')}${shot.image.src}`,
  ),
};
---

<Base
  title="Android TV launcher screenshots"
  description="Every BlueLauncher screen at 1920×1080: home grid, search, favorites and the settings dialog on an Android TV home screen."
  keywords={keywords}
  breadcrumb={crumbs}
>
  <div class="page-intro">
    <p class="kicker">Screenshots</p>
    <h1 class="display page-intro__title">BlueLauncher screenshots</h1>
    <p class="lede">
      Four screens capture the whole launcher: home, search, favorites and the settings dialog.
      Captured at 1920×1080 on a TV-sized display; the settings dialog opens over the home screen
      rather than replacing it.
    </p>
    <Breadcrumbs items={crumbs} />
  </div>

  <section class="section section--flush" aria-labelledby="gallery-title">
    <h2 class="visually-hidden" id="gallery-title">Screenshot gallery</h2>
    <Gallery />
  </section>

  <section class="section" aria-labelledby="details-title">
    <SectionHead kicker="Detail" title="What each screen does" id="details-title" />
    <div class="details">
      {
        SHOTS.map((shot) => (
          <article class="detail">
            <h3 class="detail__title">{shot.title}</h3>
            <p class="detail__text">{shot.caption}</p>
            <p class="detail__extra">{shot.detail}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="notice">
      <h2 class="h3">Version</h2>
      <p class="muted">
        These captures show version {SITE.version}. When the layout changes, the images are
        regenerated. <a href={url('/changelog/')}>See what changed in {SITE.version}</a>
      </p>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(gallerySchema)}
    slot="head-extras"
  />
</Base>

<style>
  .page-intro {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) var(--gap-xl);
    max-width: 64ch;
  }

  .page-intro__title {
    margin-top: var(--gap);
    font-size: clamp(2rem, 1.3rem + 3vw, 3.25rem);
  }

  .page-intro :global(.lede) {
    margin-top: var(--gap-md);
  }

  .section--flush {
    padding-top: 0;
    border-top: 0;
  }

  .details {
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  @media (min-width: 800px) {
    .details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .detail {
    padding: var(--gap-md);
    background: rgb(11 17 29 / 92%);
  }

  .detail__title {
    font-size: var(--step-2);
    letter-spacing: -0.015em;
  }

  .detail__text {
    margin-top: 0.5rem;
    color: var(--text-dim);
    font-size: var(--step-0);
  }

  .detail__extra {
    margin-top: 0.5rem;
    color: var(--text-faint);
    font-size: var(--step--1);
  }

  .notice {
    max-width: 60ch;
    padding: var(--gap-md);
    border-left: 2px solid var(--border-accent);
    background: rgb(47 125 255 / 6%);
    border-radius: 0 var(--r-md) var(--r-md) 0;
  }

  .notice p {
    margin-top: var(--gap-sm);
    font-size: var(--step-0);
  }
</style>
