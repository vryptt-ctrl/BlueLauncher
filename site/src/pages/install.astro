---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import StepList from '@/components/StepList.astro';
import SectionHead from '@/components/SectionHead.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import { INSTALL_STEPS, ADB_STEPS, INSTALL_TROUBLESHOOTING } from '@/data/content';
import { SITE } from '@/lib/site';
import { url } from '@/lib/url';

const crumbs = [{ name: 'Install', path: '/install/' }];

const requirements = [
  `Android TV or Google TV on Android ${SITE.minSdkName} (API ${SITE.minSdk}) or newer`,
  'An arm64-v8a, armeabi-v7a or x86_64 device',
  'A way to move the APK to the TV: USB drive, file-transfer app, or the TV’s own browser',
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: INSTALL_TROUBLESHOOTING.map((item) => ({
    '@type': 'Question',
    name: item.title,
    acceptedAnswer: { '@type': 'Answer', text: item.body },
  })),
};
---

<Base
  title="Install on Android TV"
  description="Download the signed BlueLauncher APK, install it on Android TV or Google TV from a USB drive or over adb, and set it as your home screen."
  breadcrumb={crumbs}
>
  <div class="page-intro">
    <p class="kicker">Install</p>
    <h1 class="display page-intro__title">Install on Android TV</h1>
    <p class="lede">
      BlueLauncher is a normal APK, signed by the maintainer. There is no store listing and no
      companion app.
    </p>
    <Breadcrumbs items={crumbs} />
    <div class="cluster page-intro__actions">
      <Button href={SITE.releases} external icon="download">Download latest APK</Button>
    </div>
  </div>

  <section class="section" aria-labelledby="req-title">
    <SectionHead kicker="Before you start" title="Requirements" id="req-title" />
    <ul class="checklist">
      {
        requirements.map((item) => (
          <li>
            <Icon name="check" size={17} />
            {item}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="steps-title">
    <SectionHead kicker="Steps" title="Install in three steps" id="steps-title" />
    <StepList steps={INSTALL_STEPS} label="Install" />
  </section>

  <section class="section" aria-labelledby="adb-title">
    <SectionHead
      kicker="Alternative"
      title="Install with adb"
      lede="For developers, or if the TV has no usable file manager."
      id="adb-title"
    />
    <StepList steps={ADB_STEPS} label="adb" />
  </section>

  <section class="section" aria-labelledby="trouble-title">
    <SectionHead kicker="Troubleshooting" title="Common problems" id="trouble-title" />
    <div class="faq">
      {
        INSTALL_TROUBLESHOOTING.map((item) => (
          <details class="faq__item">
            <summary>{item.title}</summary>
            <p>{item.body}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="notice">
      <h2 class="h3">Prefer to build it yourself?</h2>
      <p class="muted">
        The source is on GitHub. See the <a href={url('/developers/')}>developer guide</a> for build steps.
      </p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head-extras" />
</Base>
