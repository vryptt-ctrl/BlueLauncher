---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Gallery from '@/components/Gallery.astro';
import TVFrame from '@/components/TVFrame.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import StepList from '@/components/StepList.astro';
import { SITE } from '@/lib/site';
import { url } from '@/lib/url';
import { HIGHLIGHTS, FEATURES } from '@/data/features';
import { INSTALL_STEPS } from '@/data/content';
import { SHOTS } from '@/data/shots';

const hero = SHOTS[0];

/** Each answer is mirrored from the README or the source. */
const FAQ = [
  {
    q: 'Does it need an internet connection?',
    a: 'No. The app declares no network permission, so it cannot go online. There are no ads, analytics or crash reporters.',
  },
  {
    q: 'Which devices are supported?',
    a: `Android TV and Google TV devices running Android ${SITE.minSdkName} (API ${SITE.minSdk}) or newer, on arm64-v8a, armeabi-v7a or x86_64.`,
  },
  {
    q: 'Will it replace my current home screen?',
    a: 'Only if you choose it. Pick BlueLauncher in the Home-app chooser, or set it with one adb command. Your previous launcher stays installed.',
  },
  {
    q: 'Is it on the Play Store?',
    a: 'No. It is distributed as a signed APK on GitHub Releases and installed by sideloading.',
  },
  {
    q: 'Is it free?',
    a: 'Yes. It is open source under GPL-3.0, with no paid tier and no telemetry.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base
  title="BlueLauncher — a lightweight, offline Android TV launcher"
  description={SITE.description}
  bare
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="kicker">Android TV home launcher</p>
      <h1 class="display hero__title" id="hero-title">
        A fast, <span class="gradient-text">offline</span> home screen for your TV
      </h1>
      <p class="hero__lede">
        BlueLauncher is a small, open-source launcher built for the remote: favorites, search,
        recents and themes, with no ads and nothing sent off your device.
      </p>
      <div class="hero__actions">
        <Button href={SITE.releases} size="lg" external icon="download">Download APK</Button>
        <Button href={url('/install/')} variant="secondary" size="lg" icon="arrow">
          How to install
        </Button>
      </div>
      <p class="hero__meta">
        v{SITE.version} · Android {SITE.minSdkShort}+ · {SITE.releaseApkSize}
      </p>
    </div>

    <div class="hero__media">
      <TVFrame shot={hero} priority sizes="(min-width: 1000px) 620px, 92vw" class="hero__tv" />
    </div>
  </section>

  <section class="section section--lead" aria-labelledby="highlights-title">
    <h2 class="visually-hidden" id="highlights-title">At a glance</h2>
    <ul class="stats">
      {
        HIGHLIGHTS.map((item) => (
          <li class="stat">
            <span class="stat__icon">
              <Icon name={item.icon as any} size={18} />
            </span>
            <span class="stat__value">{item.stat}</span>
            <span class="stat__label">{item.label}</span>
            <span class="stat__body">{item.body}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" id="features" aria-labelledby="features-title">
    <SectionHead
      kicker="Features"
      title="Everything you use, nothing you don’t"
      id="features-title"
    />
    <div class="grid grid--3">
      {
        FEATURES.map((item) => (
          <FeatureCard icon={item.icon as any} title={item.title} body={item.body} />
        ))
      }
    </div>
  </section>

  <section class="section" id="screenshots" aria-labelledby="screens-title">
    <SectionHead kicker="Screenshots" title="See it in action" id="screens-title" />
    <Gallery />
  </section>

  <section class="section" aria-labelledby="install-title">
    <SectionHead
      kicker="Install"
      title="Up and running in three steps"
      lede="No store listing and no companion app."
      id="install-title"
    />
    <StepList steps={INSTALL_STEPS} label="Install" />
    <p class="section__more">
      <a href={url('/install/')}
        >Full guide, adb and troubleshooting <Icon name="arrow" size={16} /></a
      >
    </p>
  </section>

  <section class="section split" aria-labelledby="faq-title">
    <SectionHead kicker="FAQ" title="Common questions" id="faq-title" />
    <div class="faq">
      {
        FAQ.map((item) => (
          <details class="faq__item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head-extras" />
</Base>

<style>
  /* ── Hero ──────────────────────────────────────────────────────────── */
  .hero {
    display: grid;
    gap: var(--gap-xl);
    align-items: center;
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }

  @media (min-width: 1000px) {
    .hero {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
      gap: var(--gap-xl);
    }
  }

  .hero__title {
    margin-top: var(--gap);
    font-size: var(--step-5);
    max-width: 14ch;
  }

  .hero__lede {
    margin-top: var(--gap-md);
    max-width: 46ch;
    font-size: var(--step-2);
    font-weight: 300;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-sm);
    margin-top: var(--gap-lg);
  }

  /* The gallery below repeats this caption, so phones skip it here. */
  @media (max-width: 699px) {
    .hero__media :global(.tv__caption) {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .hero__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }

  /* The home screenshot leaves its lower third empty; crop it in the hero only. */
  .hero__media :global(.tv__screen) {
    aspect-ratio: 16 / 10;
  }

  .hero__media :global(.tv__image) {
    object-position: top;
  }

  .hero__meta {
    margin-top: var(--gap-md);
    font-size: var(--step--1);
    color: var(--text-dim);
  }

  .hero__media {
    position: relative;
  }

  .hero__media::before {
    /* Glow behind the TV frame, matching the launcher's accent glow. Kept
       inside the media box so it never widens the document on narrow screens. */
    content: '';
    position: absolute;
    inset: 8% 0 -12% 0;
    background: radial-gradient(closest-side, rgb(47 125 255 / 28%), transparent 78%);
    filter: blur(18px);
    z-index: -1;
    pointer-events: none;
  }

  /* ── Stats ─────────────────────────────────────────────────────────── */
  .stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 900px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Phones: keep the strip compact, the label says enough. */
  @media (max-width: 899px) {
    .stat__body {
      display: none;
    }

    .stat {
      padding: var(--gap);
    }
  }

  .stat {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: var(--gap-md);
    background: linear-gradient(180deg, rgb(28 39 63 / 45%), rgb(11 17 29 / 92%));
  }

  .stat__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    margin-bottom: 0.35rem;
    border-radius: var(--r-sm);
    color: var(--cyan);
    background: rgb(124 225 255 / 8%);
    border: 1px solid rgb(124 225 255 / 16%);
  }

  .stat__value {
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--text);
  }

  .stat__label {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-bright);
  }

  .stat__body {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-dim);
  }

  /* ── Grid ──────────────────────────────────────────────────────────── */
  .grid {
    display: grid;
    gap: var(--gap);
  }

  @media (min-width: 640px) {
    .grid--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .grid--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Heading left, answers right on wide screens. */
  @media (min-width: 900px) {
    .split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
      gap: var(--gap-xl);
      align-items: start;
    }

    .split :global(.head) {
      position: sticky;
      top: calc(var(--nav-h) + var(--gap-md));
      margin-bottom: 0;
    }

    .split :global(.faq) {
      max-width: none;
    }
  }

  .section__more {
    margin-top: var(--gap-md);
    font-size: var(--step-0);
  }

  .section__more a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    text-decoration: none;
  }

  .section__more a:hover {
    gap: 0.6rem;
  }
</style>
