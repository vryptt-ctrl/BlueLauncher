---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SectionHead from '@/components/SectionHead.astro';
import SpecTable from '@/components/SpecTable.astro';
import Icon from '@/components/Icon.astro';
import { ARCH_LAYERS, DEPENDENCIES } from '@/data/content';
import { SITE } from '@/lib/site';

const crumbs = [{ name: 'Architecture', path: '/architecture/' }];
const keywords = [
  'Android launcher architecture',
  'Rust JNI Android',
  'programmatic Android Views',
  'Leanback launcher internals',
];

const flow = [
  {
    step: 'Lifecycle',
    owner: 'MainActivity',
    body: 'Resume, pause, back and the short-lived package receiver all live in one activity. No service, no widget provider.',
  },
  {
    step: 'Discovery',
    owner: 'AppRepository',
    body: 'Scoped launcher and Leanback queries resolve labelled, launchable activities off the main thread.',
  },
  {
    step: 'Ranking',
    owner: 'NativeEngine → Rust',
    body: 'Labels, pins and recents are packed into one string and scored natively; JNI marshals the result back as ranked lines.',
  },
  {
    step: 'Rendering',
    owner: 'LauncherViews',
    body: 'Platform Views are built and updated in place. Focus lift, glow and palette roles come from TvUi and Palette.',
  },
];
---

<Base
  title="Android TV launcher architecture"
  description="How the BlueLauncher Android TV launcher is built: one activity, programmatic platform Views, a small preference model and a Rust JNI ranking core."
  keywords={keywords}
  breadcrumb={crumbs}
>
  <div class="page-intro">
    <p class="kicker">Architecture</p>
    <h1 class="display page-intro__title">BlueLauncher architecture</h1>
    <p class="lede">
      Four layers, no framework between them. The Android side never blocks on the native side, and
      the native side never touches the UI.
    </p>
    <Breadcrumbs items={crumbs} />
  </div>

  <section class="section" aria-labelledby="flow-title">
    <SectionHead kicker="Data flow" title="From package query to focused card" id="flow-title" />
    <ol class="flow">
      {
        flow.map((stage, index) => (
          <li class="flow__stage">
            <span class="flow__badge">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <p class="flow__step">{stage.step}</p>
              <h3 class="flow__owner">{stage.owner}</h3>
              <p class="flow__body">{stage.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section" aria-labelledby="modules-title">
    <SectionHead kicker="Modules" title="Where each responsibility lives" id="modules-title" />
    <SpecTable
      head={['Layer', 'Path', 'Responsibility']}
      rows={ARCH_LAYERS.map((layer) => [layer.title, { text: layer.file, mono: true }, layer.body])}
    />
  </section>

  <section class="section" aria-labelledby="deps-title">
    <SectionHead
      kicker="Dependencies"
      title="What the project depends on"
      lede="Mostly things it does not depend on."
      id="deps-title"
    />
    <div class="grid">
      {
        DEPENDENCIES.map((item) => (
          <article class="card">
            <span class="card__icon">
              <Icon name="check" size={16} />
            </span>
            <h3 class="card__title">{item.title}</h3>
            <p class="card__body">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="native-title">
    <SectionHead kicker="Native boundary" title="What crosses JNI." id="native-title" />
    <div class="split">
      <div class="prose-custom">
        <p class="muted">
          The Kotlin side does not pass objects across the boundary. Apps are serialized as
          <code>package&#92;tlabel</code> lines, floating favorites and recents are newline-separated
          lists, and the ranked output comes back in the same line format. That keeps the JNI surface
          to a handful of string arguments and avoids object lifetime problems entirely.
        </p>
        <p class="muted">
          ProGuard rules keep the native entry points alive through R8, and the library reports
          availability at startup so the Kotlin fallback can take over on unsupported ABIs.
        </p>
      </div>
      <ul class="facts">
        <li><span>Native crate</span><code>blue-launcher-native</code></li>
        <li><span>JNI binding</span><code>jni 0.21</code></li>
        <li><span>Optimization</span><code>opt-level = "s"</code></li>
        <li><span>LTO / codegen</span><code>true / 1</code></li>
        <li><span>Panic strategy</span><code>abort</code></li>
        <li><span>Symbols</span><code>stripped</code></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="notice">
      <h2 class="h3">One activity, no services</h2>
      <p class="muted">
        The launcher registers HOME and LEANBACK_LAUNCHER but runs nothing in the background. A
        debounced receiver coalesces install broadcasts while the home screen is visible, and a scan
        on the next resume covers anything missed.
      </p>
      <p class="dim">
        Version {SITE.version} · minSdk {SITE.minSdk} · compileSdk {SITE.compileSdk}
      </p>
    </div>
  </section>
</Base>

<style>
  .page-intro {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) var(--gap-xl);
    max-width: 64ch;
  }

  .page-intro__title {
    margin-top: var(--gap);
    font-size: clamp(2rem, 1.3rem + 3vw, 3.25rem);
  }

  .page-intro :global(.lede) {
    margin-top: var(--gap-md);
  }

  .flow {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--gap);
  }

  @media (min-width: 900px) {
    .flow {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--gap-sm);
    }
  }

  .flow__stage {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--gap-sm);
    padding: var(--gap-md);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, rgb(28 39 63 / 50%), rgb(11 17 29 / 92%));
  }

  .flow__badge {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: var(--r-sm);
    border: 1px solid rgb(124 225 255 / 22%);
    background: rgb(124 225 255 / 8%);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--cyan);
  }

  .flow__step {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .flow__owner {
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--accent-bright);
    letter-spacing: -0.01em;
  }

  .flow__body {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--text-dim);
  }

  .grid {
    display: grid;
    gap: var(--gap);
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    margin-bottom: var(--gap-sm);
    border-radius: var(--r-sm);
    color: var(--cyan);
    background: rgb(124 225 255 / 8%);
    border: 1px solid rgb(124 225 255 / 18%);
  }

  .split {
    display: grid;
    gap: var(--gap-lg);
  }

  @media (min-width: 860px) {
    .split {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: start;
    }
  }

  .prose-custom p {
    font-size: var(--step-0);
  }

  .prose-custom p + p {
    margin-top: var(--gap);
  }

  .prose-custom code {
    color: var(--accent-bright);
    background: rgb(5 8 15 / 70%);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }

  .facts {
    list-style: none;
    padding: 0;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow: hidden;
    background: rgb(17 26 42 / 55%);
  }

  .facts li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap);
    padding: 0.65rem 0.95rem;
    border-bottom: 1px solid var(--border);
    font-size: var(--step--1);
  }

  .facts li:last-child {
    border-bottom: 0;
  }

  .facts span {
    color: var(--text-faint);
  }

  .facts code {
    color: var(--accent-bright);
    font-size: 0.8125rem;
  }

  .notice {
    max-width: 70ch;
    padding: var(--gap-md);
    border-left: 2px solid var(--border-accent);
    background: rgb(47 125 255 / 6%);
    border-radius: 0 var(--r-md) var(--r-md) 0;
  }

  .notice p {
    margin-top: var(--gap-sm);
    font-size: var(--step-0);
  }
</style>
