---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import SpecTable from '@/components/SpecTable.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import StepList from '@/components/StepList.astro';
import Button from '@/components/Button.astro';
import { BUILD_PREREQS, GRADLE_COMMANDS, ABI_TABLE } from '@/data/content';
import { SITE } from '@/lib/site';

const steps = [
  {
    title: 'Set the NDK path',
    body: 'Gradle runs Cargo for all three ABIs and needs the NDK location. Skip this if the NDK sits under the default $ANDROID_HOME/ndk path.',
    code: `$env:ANDROID_NDK_HOME = "$env:ANDROID_HOME/ndk/${SITE.ndkVersion}"`,
    lang: 'powershell',
  },
  {
    title: 'Add the Rust targets',
    body: 'One target per packaged ABI. Rustup downloads and caches them.',
    code: 'rustup target add aarch64-linux-android armv7-linux-androideabi x86_64-linux-android',
    lang: 'shell',
  },
  {
    title: 'Build, test and lint',
    body: 'The Gradle build compiles the cdylib for each ABI and packages the shared libraries automatically.',
    code: '.\\gradlew.bat assembleDebug testDebugUnitTest lintDebug',
    lang: 'powershell',
  },
];

const releaseNotes = [
  'assembleRelease runs R8 and resource shrinking and produces an unsigned APK.',
  'Add a private signingConfig before distributing — the repository ships no signing key.',
  'Unit tests cover the pure preference and category logic on the JVM, without Robolectric.',
];
---

<Base
  title="Build from source"
  description="Build BlueLauncher yourself: JDK 17, Android SDK Platform 36, NDK 27.2.12479018 and three Rust targets."
>
  <div class="page-intro">
    <p class="kicker">Build</p>
    <h1 class="display page-intro__title">Build from source</h1>
    <p class="lede">
      The Gradle build drives Cargo for every packaged ABI. You need the NDK once, and three
      installed Rust targets.
    </p>
    <div class="cluster page-intro__actions">
      <Button href={SITE.repo} external icon="github">Open the repository</Button>
      <Button href={SITE.contributing} external variant="secondary" icon="code"
        >Contribution guide</Button
      >
    </div>
  </div>

  <section class="section" aria-labelledby="prereq-title">
    <SectionHead kicker="Prerequisites" title="Required tools" id="prereq-title" />
    <SpecTable
      head={['Tool', 'Version', 'Notes']}
      rows={BUILD_PREREQS.map((item) => [item.label, { text: item.value, mono: true }, item.note])}
    />
  </section>

  <section class="section" aria-labelledby="steps-title">
    <SectionHead kicker="Build" title="Build steps" id="steps-title" />
    <StepList steps={steps} label="Build" />
  </section>

  <section class="section" aria-labelledby="commands-title">
    <SectionHead
      kicker="Command reference"
      title="Useful commands"
      id="commands-title"
    />
    <div class="commands">
      {
        GRADLE_COMMANDS.map((entry) => (
          <div class="command">
            <CodeBlock code={entry.command} label="shell" />
            <p class="command__note">{entry.note}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="abi-title">
    <SectionHead
      kicker="Packaging"
      title="Three ABIs, two page sizes."
      lede="ARM64 and x86_64 are linked with 16 KB page alignment for Android 15+ devices; 32-bit ARM keeps its 4 KB layout."
      id="abi-title"
    />
    <SpecTable
      head={['ABI', 'Rust target', 'Native pages']}
      rows={ABI_TABLE.map((row) => [row.abi, { text: row.target, mono: true }, row.pages])}
    />
  </section>

  <section class="section" aria-labelledby="release-title">
    <SectionHead kicker="Release" title="Signing a release" id="release-title" />
    <ul class="notes-list">
      {releaseNotes.map((note) => <li>{note}</li>)}
    </ul>
  </section>

  <section class="section">
    <div class="notice">
      <h2 class="h3">Output locations</h2>
      <p class="muted">
        The debug APK lands at <code>app/build/outputs/apk/debug/app-debug.apk</code> — about 3.9 MB with
        all three ABIs. Native libraries are compiled into
        <code>app/build/rust-jni/&lt;abi&gt;/libblue_launcher.so</code> before packaging.
      </p>
    </div>
  </section>
</Base>

<style>
  .page-intro {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) var(--gap-xl);
    max-width: 64ch;
  }

  .page-intro__title {
    margin-top: var(--gap);
    font-size: clamp(2rem, 1.3rem + 3vw, 3.25rem);
  }

  .page-intro :global(.lede) {
    margin-top: var(--gap-md);
  }

  .page-intro__actions {
    margin-top: var(--gap-lg);
  }

  .commands {
    display: grid;
    /* minmax(0, 1fr): an implicit auto track would inherit the widest <pre>
       line length instead of letting the code block scroll on its own. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-md);
  }

  .command {
    min-width: 0;
  }

  .command__note {
    margin-top: 0.55rem;
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .notes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--gap-sm);
    max-width: 74ch;
  }

  .notes-list li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--text-muted);
    font-size: var(--step-0);
  }

  .notes-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: linear-gradient(135deg, #5aa9ff, #2f7dff);
    box-shadow: 0 0 0 1px rgb(124 225 255 / 45%);
  }

  .notice {
    max-width: 70ch;
    padding: var(--gap-md);
    border-left: 2px solid var(--border-accent);
    background: rgb(47 125 255 / 6%);
    border-radius: 0 var(--r-md) var(--r-md) 0;
  }

  .notice p {
    margin-top: var(--gap-sm);
    font-size: var(--step-0);
  }

  .notice code {
    color: var(--accent-bright);
  }
</style>
